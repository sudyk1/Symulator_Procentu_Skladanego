# Dependencies and build output (recreated by npm ci / npm run build)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Tests
coverage/

# Logs
*.log
npm-debug.log*

# Environment variables – never commit secrets; keep an example in .env.example
.env
.env.*
!.env.example

# Editors: shared VS Code settings may be committed, everything else is personal
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Claude Code: shared project settings (.claude/settings.json) stay in the repo;
# local settings, the preview config and saved reports (e.g. Lighthouse JSON) do not
.claude/*.json
!.claude/settings.json
